DATABASE_URL=sqlite:///./dev.db
ALLOWED_ORIGINS=https://comstratmedia.com,http://localhost:5173
SECRET_KEY=CHANGE_THIS_TO_A_REAL_SECRET

# Mode reel Sage X3
SAGE_X3_PUSH_MODE=http

# URL cible Sage X3 pour les appels sortants (health, outbox, confirmations)
SAGE_X3_BASE_URL=https://sage-x3.votre-domaine.com
SAGE_X3_API_KEY=REPLACE_WITH_REAL_SAGE_API_KEY
SAGE_X3_AUTH_SCHEME=bearer
SAGE_X3_AUTH_HEADER=Authorization
SAGE_X3_HEALTH_ENDPOINT=/health
SAGE_X3_DELIVERY_ENDPOINT=/deliveries
SAGE_X3_STOCK_MOVEMENT_ENDPOINT=/stock-movements
SAGE_X3_TIMEOUT_SECONDS=30
INTEGRATION_OUTBOX_MAX_RETRIES=3

# Auth entrante pour /api/integration/sage/programs
# Option 1: header custom du type X-Sage-X3-Token: <token>
SAGE_X3_INBOUND_AUTH_SCHEME=token
SAGE_X3_INBOUND_AUTH_HEADER=X-Sage-X3-Token
SAGE_X3_INBOUND_TOKEN=REPLACE_WITH_REAL_INBOUND_SHARED_SECRET

# Option 2 alternative si Sage envoie Authorization: Bearer <token>
# SAGE_X3_INBOUND_AUTH_SCHEME=bearer
# SAGE_X3_INBOUND_AUTH_HEADER=Authorization