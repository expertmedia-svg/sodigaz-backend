# Backend Configuration Example
# Copy this file to .env and fill in the actual values
# NEVER commit .env file - it contains secrets!

# Database
DATABASE_URL=sqlite:///./dev.db
# For production: DATABASE_URL=postgresql://user:password@host:5432/database_name

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Frontend domains allowed
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://sodigazback.yingr-ai.com

# Sage X3 Integration Settings
SAGE_X3_PUSH_MODE=mock
SAGE_X3_TIMEOUT_SECONDS=30
INTEGRATION_OUTBOX_MAX_RETRIES=3

# Sage SQL Server Connection (REQUIRED for production)
# Get these values from your Sage X3 administrator
SAGE_SQL_SERVER=your-sage-server-host,port
SAGE_SQL_DATABASE=x3v12
SAGE_SQL_SCHEMA=SODIGAZG
SAGE_SQL_USER=your-sage-username
SAGE_SQL_PASSWORD=your-sage-password
SAGE_SQL_DRIVER=ODBC Driver 17 for SQL Server
SAGE_SQL_TIMEOUT_SECONDS=30

# Sage SQL Daily Sync Schedule
SAGE_SQL_DAILY_SYNC_TIME=06:00
SAGE_SQL_DAILY_SYNC_ENABLED=true

# Optional
GOOGLE_MAPS_API_KEY=your-google-maps-key
