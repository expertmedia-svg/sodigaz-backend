# Configuration Production
# IMPORTANT: Never commit actual values. Use secure secret management!

# Database
DATABASE_URL=postgresql://user:password@prod-db-host:5432/gas_platform
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Domaines de production
ALLOWED_ORIGINS=https://sodigazback.yingr-ai.com,https://comstratmedia.com,https://driver.sodigaz.com,https://admin.sodigaz.com

# Sage X3 Integration
SAGE_X3_PUSH_MODE=sql
SAGE_X3_TIMEOUT_SECONDS=30
INTEGRATION_OUTBOX_MAX_RETRIES=3

# Sage SQL Server Connection (Template - Fill with actual values from Sage admin)
# These must be set via environment variables, not in git
SAGE_SQL_SERVER=replace-with-actual-server-and-port
SAGE_SQL_DATABASE=x3v12
SAGE_SQL_SCHEMA=SODIGAZG
SAGE_SQL_USER=replace-with-actual-username
SAGE_SQL_PASSWORD=replace-with-actual-password
SAGE_SQL_DRIVER=ODBC Driver 17 for SQL Server
SAGE_SQL_TIMEOUT_SECONDS=30

# Sage SQL Daily Sync Schedule
SAGE_SQL_DAILY_SYNC_TIME=06:00
SAGE_SQL_DAILY_SYNC_ENABLED=true
